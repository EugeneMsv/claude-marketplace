{
  "description": "Bash Brief — annotates Bash commands with a one-sentence technical summary before the approval decision",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/bash-brief/bash-command-summarizer.py",
            "timeout": 12
          }
        ]
      }
    ]
  }
}
