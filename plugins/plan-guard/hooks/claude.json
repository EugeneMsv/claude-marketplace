{
  "description": "Plan Guard \u2014 enforces plan mode constraints and syncs plan files to project directories",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLAN_GUARD_STATIC_RULES=1 python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/plan-guard/plan-mode-enforcer.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/plan-guard/plan-sync.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
